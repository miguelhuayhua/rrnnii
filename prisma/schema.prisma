generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  usuario   String     @unique
  password  String
  createdAt DateTime   @default(now())
  id        String     @id @default(dbgenerated("generate_object_id()"))
  estado    Boolean    @default(true)
  avatar    String?
  rol       String
  Persona   Persona    @relation(fields: [personaId], references: [id])
  personaId String     @unique @default("")
  Acciones  Acciones[]
}

model Convenio {
  id              String            @id @default(dbgenerated("generate_object_id()"))
  titulo          String            @default("")
  finalizacion    String?           @default("")
  createdAt       DateTime          @default(now())
  estado          Boolean           @default(true)
  tipo            String            @default("nacional")
  descripcion     String            @default("")
  pdf             String            @default("")
  imagen          String            @default("")
  institucionId   String            @default("")
  pais            String            @default("")
  continente      String            @default("")
  Institucion     Institucion?      @relation(fields: [institucionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ConvenioCarrera ConvenioCarrera[]
  conteo          Int               @default(1)
}

model Pasantia {
  id              String            @id @default(dbgenerated("generate_object_id()"))
  titulo          String            @default("")
  finalizacion    String?           @default("")
  createdAt       DateTime          @default(now())
  modalidad       String            @default("")
  descripcion     String            @default("")
  pdf             String            @default("")
  estado          Boolean           @default(true)
  imagen          String            @default("")
  institucionId   String?           @default("")
  Institucion     Institucion?      @relation(fields: [institucionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  PasantiaCarrera PasantiaCarrera[]
  conteo          Int               @default(1)
}

model Beca {
  id            String             @id @default(dbgenerated("generate_object_id()"))
  titulo        String             @default("")
  createdAt     DateTime           @default(now())
  descripcion   String             @default("")
  pdf           String             @default("")
  termina       String             @default("")
  estado        Boolean            @default(true)
  imagen        String             @default("")
  encargado     String             @default("")
  pais          String             @default("")
  continente    String             @default("")
  Participantes ParticipanteBeca[]
  tipo          String             @default("nacional")
  institucionId String?            @default("")
  Institucion   Institucion?       @relation(fields: [institucionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conteo        Int                @default(1)
}

model ParticipanteBeca {
  id              String    @id @default(dbgenerated("generate_object_id()"))
  nombre_completo String    @default("")
  contacto        String    @default("")
  becaId          String    @default("")
  Beca            Beca?     @relation(fields: [becaId], references: [id])
  ru              String    @default("")
  ci              String    @default("")
  rupath          String    @default("")
  cipath          String    @default("")
  createdAt       DateTime  @default(now())
  aceptado        Boolean   @default(false)
  Archivos        Archivo[]
}

model Evento {
  id          String   @id @default(dbgenerated("generate_object_id()"))
  titulo      String   @default("")
  createdAt   DateTime @default(now())
  inicio      String   @default("")
  descripcion String   @default("")
  pdf         String   @default("")
  tipo        String   @default("")
  link        String?  @default("")
  estado      Boolean  @default(true)
  imagen      String   @default("")
  conteo      Int      @default(1)
}

model Noticia {
  id          String   @id @default(dbgenerated("generate_object_id()"))
  titulo      String   @default("")
  createdAt   DateTime @default(now())
  descripcion String   @default("")
  estado      Boolean  @default(true)
  imagen      String   @default("")
}

model Video {
  id          String   @id @default(dbgenerated("generate_object_id()"))
  titulo      String   @default("")
  createdAt   DateTime @default(now())
  descripcion String   @default("")
  estado      Boolean  @default(true)
  video       String   @default("")
  conteo      Int      @default(1)
}

model Institucion {
  id        String     @id @default(dbgenerated("generate_object_id()"))
  nombre    String     @unique
  createdAt DateTime   @default(now())
  estado    Boolean    @default(true)
  ubicacion String     @default("")
  logo      String     @default("")
  contacto  Int?       @default(0)
  Convenios Convenio[]
  Pasantia  Pasantia[]
  Becas     Beca[]
  video     String?    @default("")
  web       String?    @default("")
}

model ConvenioCarrera {
  id         String    @id @default(dbgenerated("generate_object_id()"))
  convenioId String    @default("")
  Convenio   Convenio? @relation(fields: [convenioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  carreraId  String    @default("")
  Carrera    Carrera?  @relation(fields: [carreraId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model PasantiaCarrera {
  id         String    @id @default(dbgenerated("generate_object_id()"))
  pasantiaId String
  Pasantia   Pasantia? @relation(fields: [pasantiaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  carreraId  String
  Carrera    Carrera?  @relation(fields: [carreraId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Carrera {
  id              String            @id @default(dbgenerated("generate_object_id()"))
  nombre          String            @default("")
  createdAt       DateTime          @default(now())
  logo            String            @default("")
  ConvenioCarrera ConvenioCarrera[]
  contacto        Int?              @default(0)
  estado          Boolean           @default(true)
  PasantiaCarrera PasantiaCarrera[]
}

model Unidad {
  id        String @id @default("rrnnii")
  contacto  String @default("")
  email     String @default("")
  ubicacion String @default("")
}

model Persona {
  nombre       String   @default("")
  paterno      String   @default("")
  materno      String   @default("")
  f_nacimiento String   @default("")
  ci           String
  id           String   @id @default(dbgenerated("generate_object_id()"))
  Usuario      Usuario?
  estado       Boolean  @default(true)
  createdAt    DateTime @default(now())
  cargo        String   @default("")
}

model Acciones {
  id        String   @id @default(dbgenerated("generate_object_id()"))
  usuarioId String   @default("")
  Usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  tabla     String   @default("")
  tipo      String   @default("")
  createdAt DateTime @default(now())
}

model Visitantes {
  id          String   @id @default(dbgenerated("generate_object_id()"))
  ip          String   @default("")
  dispositivo String   @default("")
  createdAt   DateTime @default(now())
}

model Archivo {
  id                 String            @id @default(dbgenerated("generate_object_id()"))
  participanteBecaid String            @default("")
  ParticipanteBeca   ParticipanteBeca? @relation(fields: [participanteBecaid], references: [id])
  ruta               String            @default("")
}
